# protonpass-to-bitwarden-sync -- environment configuration
#
# The script auto-loads this file on startup (it works from any shell --
# bash, fish, zsh -- you never source it yourself). Copy it to .env and
# edit it:
#
#   cp .env.example .env
#   # edit .env
#   ./protonpass-to-bitwarden-sync.sh --dry-run
#
# A variable already exported in your environment will be overwritten by
# the value here, so COMMENT A VALUE OUT if you want the environment value
# to take precedence. All values are optional; the defaults shown here are
# what the script uses when the variable is unset.

# Path to the Proton Pass CLI binary (default: pass-cli)
PROTON_PASS_BIN=pass-cli

# Path to the Bitwarden CLI binary (default: bw)
BITWARDEN_BIN=bw

# Bitwarden server URL. When set, the script ensures `bw` is pointed at
# this server before authenticating (skips the call if already matched).
# Set to a self-hosted instance such as Vaultwarden to target it:
#   BW_SERVER=https://vaultwarden.example.com
# Comment this out (leave BW_SERVER unset) to use whatever `bw` is
# already configured against -- the script will not touch bw's config.
BW_SERVER=https://vault.bitwarden.com

# Dry-run mode: "true" previews what would be created without writing
# anything. Equivalent to passing --dry-run on the command line.
DRY_RUN=false

# Leave existing items untouched, creating only new items. Equivalent to
# passing --skip-existing on the command line.
SKIP_EXISTING=false

# Also sync Proton Pass items that have been moved to Trash. By default only
# Active items are synced. Equivalent to --include-trashed.
INCLUDE_TRASHED=false

# Bitwarden session key. OPTIONAL -- leave commented to let the script
# unlock the vault itself: if `bw status` reports "locked" the script runs
# `bw unlock --raw` interactively (prompts for your master password) and
# keeps the session for that run only. Set this only if you prefer to
# unlock ahead of time with `bw unlock` and paste the printed session here.
#BW_SESSION="<paste-session-key-here>"

# Proton Pass local-key storage backend. On a desktop/laptop the default
# OS keyring is fine; on a HEADLESS or CONTAINER host (LXC/Docker) the
# kernel keyring is unavailable and pass-cli fails with NoStorageAccess /
# "Error creating client features". Uncomment on such hosts so pass-cli
# stores its DB encryption key as a file (~/.local/share/proton-pass-cli/
# .session/local.key, mode 0600). Must be set BEFORE `pass-cli login`.
#PROTON_PASS_KEY_PROVIDER=fs
